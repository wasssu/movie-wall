{% if trending.size > 0 %}
<div class="layout layout--stretch bg--black mb--0">
  <div class="grid grid--cols-2 gap--none">
    {% for show in trending limit: 8 %}
      <div class="h--full{% if forloop.index > 4 %} hidden portrait:visible{% endif %}">
        <img
          class="image image--contain image-dither w--full h--full"
          src="{{ show.poster }}"
          alt="{{ show.title }}"
        >
      </div>
    {% endfor %}
  </div>
</div>
{% else %} 
<div class="layout"><span class="title">No shows available</span></div> 
{% endif %}
<div class="title_bar rounded--none">
  <img class="image" src="data:image/svg+xml;base64,{{ movie_wall_logo | base64_encode }}">
  <span class="title">Movie Wall</span>
  <span class="instance">Trending Movies (TMDB)</span>
</div>